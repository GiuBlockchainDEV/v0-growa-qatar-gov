# Growa Qatar - Environment Variables
# 
# IMPORTANT: Never commit actual secrets to version control
# Copy this file to .env.local for local development

# =============================================================================
# DEPLOYMENT CONTEXT
# =============================================================================
NEXT_PUBLIC_DEPLOYMENT_ENV=local
NEXT_PUBLIC_COUNTRY_CODE=QA
NEXT_PUBLIC_COUNTRY_NAME=Qatar

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_SUPPORTED_LOCALES=en,ar

# =============================================================================
# SUPABASE (to be configured via v0 integration)
# =============================================================================
# These will be auto-populated when you connect Supabase via v0:
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# =============================================================================
# FEATURE FLAGS
# =============================================================================
NEXT_PUBLIC_FEATURE_MFA=false
NEXT_PUBLIC_FEATURE_SSO=false
