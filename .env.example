# Growa Qatar - Environment Variables
# Step 0.3: Environment strategy baseline
# 
# IMPORTANT: Never commit actual secrets to version control
# Copy this file to .env.local for local development
#
# Environment naming convention:
# - growa-qatar-local (development)
# - growa-qatar-preview (PR previews)
# - growa-qatar-staging (pre-production validation)
# - growa-qatar-prod (production - ISOLATED PROJECT)

# =============================================================================
# DEPLOYMENT CONTEXT
# =============================================================================
# Which environment is this deployment running in?
# Values: local | preview | staging | production
NEXT_PUBLIC_DEPLOYMENT_ENV=local

# Country deployment identifier
NEXT_PUBLIC_COUNTRY_CODE=QA
NEXT_PUBLIC_COUNTRY_NAME=Qatar

# =============================================================================
# SUPABASE CONFIGURATION
# =============================================================================
# IMPORTANT: Each environment must use its own Supabase project
# Production Qatar deployment must have an isolated Supabase project

# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anonymous key (safe for browser)
# Use ONE of these - the code supports both names:
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# OR (v0 integration uses this name):
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=

# Supabase service role key (SERVER-SIDE ONLY - never expose to client)
SUPABASE_SERVICE_ROLE_KEY=

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
# Default language for the deployment
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Supported locales (comma-separated)
NEXT_PUBLIC_SUPPORTED_LOCALES=en,ar

# =============================================================================
# FEATURE FLAGS (for gradual rollout)
# =============================================================================
# Enable/disable features per environment
NEXT_PUBLIC_FEATURE_MFA=false
NEXT_PUBLIC_FEATURE_SSO=false
NEXT_PUBLIC_FEATURE_REALTIME=false
